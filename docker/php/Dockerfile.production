FROM php:8.3-cli-alpine

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_HOME=/tmp/composer

RUN apk add --no-cache libxml2 libzip openssl \
    && openssl list -providers -provider default -provider legacy > /dev/null \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS libxml2-dev libzip-dev curl-dev \
    && docker-php-ext-install -j"$(nproc)" dom simplexml soap zip curl \
    && apk del .build-deps

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

WORKDIR /var/www/sped-nfe
COPY composer.json composer.lock ./
RUN composer install --no-dev --classmap-authoritative --no-interaction --prefer-dist

COPY . .
RUN composer dump-autoload --no-dev --classmap-authoritative --no-interaction

EXPOSE 8080
