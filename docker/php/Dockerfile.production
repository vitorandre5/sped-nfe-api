FROM php:8.3.36-cli-alpine

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_HOME=/tmp/composer

RUN printf 'post_max_size=28M\nupload_max_filesize=28M\nmemory_limit=256M\n' > /usr/local/etc/php/conf.d/fiscal-limits.ini
RUN apk add --no-cache libxml2 libzip openssl libpng freetype libjpeg-turbo oniguruma \
    && openssl list -providers -provider default -provider legacy > /dev/null \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS libxml2-dev libzip-dev curl-dev libpng-dev freetype-dev libjpeg-turbo-dev oniguruma-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" bcmath dom simplexml soap zip curl gd mbstring \
    && apk del .build-deps
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

WORKDIR /var/www/sped-nfe
COPY composer.json composer.lock ./
RUN composer install --no-dev --classmap-authoritative --no-interaction --prefer-dist

COPY . .
RUN test -s storage/config.schema \
    && test -s storage/wsnfe_4.00_mod55.xml \
    && test -s schemes/PL_010_V1.30/distDFeInt_v1.01.xsd \
    && composer dump-autoload --no-dev --classmap-authoritative --no-interaction

EXPOSE 8080
