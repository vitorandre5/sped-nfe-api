# Desenvolvimento local (API PHP + interface web)
# Copie para .env.local conforme as instruções do README.
API_PORT=8080
APP_PORT=8081
APP_ORIGIN=http://localhost:8081
API_PROXY_KEY=gere-uma-chave-aleatoria-local
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=
SUPABASE_API_URL=http://host.docker.internal:54321
# Chave anon publica usada pela API com o JWT autenticado e pelo frontend.
SUPABASE_ANON_KEY=
VITE_NFE_TPAMB=2
VITE_ALLOW_SIGNUP=true

# Ambiente fiscal; homologação (2) é o padrão para testes.
NFE_TPAMB=2
NFE_RAZAO_SOCIAL=EMPRESA NAO INFORMADA
NFE_CNPJ=
NFE_SIGLA_UF=MG
NFE_SCHEMES=PL_009_V4
NFE_VERSAO=4.00
NFE_VERAPLIC=

# Coolify usa variáveis próprias por aplicação. Não coloque segredos aqui.
# supabase-bd: credenciais SERVICE_* geradas/guardadas no Coolify.
# redis-bd: nenhuma variável configurável.
# fiscal.web: SERVICE_PASSWORD_64_APIPROXY, SERVICE_SUPABASEANON_JWT e NFE_*.
